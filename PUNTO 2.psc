Algoritmo imprimir_N
	escribir "forma del ciclo mientras"
	escribir "							"
	
	definir n Como Real
	Escribir "digite sus numero para imprimir hasta ese rango"
	leer n
	num <- 1
	Mientras num <= n hacer
		escribir num
		num <- num+1
	FinMientras
	
	escribir "							"
	
	escribir "forma del ciclo repetir"
	escribir "							"
	
	Escribir "digite sus numero para imprimir hasta ese rango"
	leer n
	num <- 1
	Repetir
		escribir num
		num <- num +1
	Hasta Que  num > n
	
	escribir "							"
	
	escribir "forma del ciclo para"
	escribir "							"
	
	Escribir "digite sus numero para imprimir hasta ese rango"
	leer n
	
	Para num <-1 hasta n con paso 1 Hacer
		escribir num
	FinPara
	
	
FinAlgoritmo
