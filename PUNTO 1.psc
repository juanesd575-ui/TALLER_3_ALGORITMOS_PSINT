Algoritmo imprimir_sena
	escribir "forma del ciclo mientras"
	definir num Como Real
	sena = "sena"
	num = 1
	Mientras num <= 5 Hacer
		Escribir  sena
		num= num+1
	Fin Mientras
	
	escribir "							"
	
	escribir "forma del ciclo repetir"
	num <- 1
	Repetir
		Escribir sena
		num = num+ 1
	Hasta Que num > 5
	escribir "							"
	
	escribir "forma del ciclo para"
	Para num <- 1 Hasta 5 Con Paso 1 Hacer
		Escribir sena
	Fin Para
	
	escribir "							"
FinAlgoritmo
